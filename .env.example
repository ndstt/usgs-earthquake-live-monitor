APP_NAME=USGS Earthquake Live Monitor
ENVIRONMENT=local
LOG_LEVEL=INFO

USGS_REALTIME_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_CATALOG_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
USGS_TIMEOUT_SECONDS=10
USGS_MAX_RETRIES=3

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=usgs-earthquake-live-monitor
KAFKA_RAW_TOPIC=earthquake.raw.v1
KAFKA_BACKFILL_TOPIC=earthquake.backfill.v1
KAFKA_NORMALIZED_TOPIC=earthquake.normalized.v1
KAFKA_DAILY_SUMMARY_TOPIC=earthquake.summary.daily.v1
KAFKA_ACKS=all
KAFKA_REQUEST_TIMEOUT_MS=15000
KAFKA_ENABLE_IDEMPOTENCE=true

SPARK_MASTER_URL=spark://localhost:7077
SPARK_APP_NAME=usgs-earthquake-live-monitor-stream
SPARK_TRIGGER_INTERVAL=30 seconds
SPARK_STARTING_OFFSETS=latest
SPARK_SHUFFLE_PARTITIONS=4
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1
SPARK_DELTA_PACKAGE=io.delta:delta-spark_2.12:3.3.2

HDFS_BASE_PATH=/data/earthquakes
HDFS_DEFAULT_FS=hdfs://localhost:9000
LOCAL_STORAGE_PATH=./data/earthquakes
USE_LOCAL_FS_FOR_STORAGE=false

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_EVENTS_INDEX_PREFIX=earthquake-events
ELASTICSEARCH_DAILY_SUMMARY_INDEX=earthquake-daily-summary-v1
ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=10
ELASTICSEARCH_BULK_BATCH_SIZE=500

POLL_INTERVAL_SECONDS=60
ENABLE_REALTIME_POLLER=true
BACKFILL_WINDOW_DAYS=30
DEDUPE_TTL_SECONDS=3600
DEDUPE_MAX_IDS=20000

