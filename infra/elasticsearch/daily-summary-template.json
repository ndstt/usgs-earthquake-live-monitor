{
  "index_patterns": ["earthquake-daily-summary-v1"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "event_date": { "type": "date" },
        "earthquake_count": { "type": "integer" },
        "avg_magnitude": { "type": "float" },
        "avg_depth_km": { "type": "float" },
        "max_magnitude": { "type": "float" },
        "tsunami_event_count": { "type": "integer" },
        "latest_update_utc": { "type": "date" },
        "summary_generated_at_utc": { "type": "date" }
      }
    }
  }
}

