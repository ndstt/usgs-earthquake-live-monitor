{
  "index_patterns": ["earthquake-events-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "event_id": { "type": "keyword" },
        "source_feed": { "type": "keyword" },
        "source_mode": { "type": "keyword" },
        "event_time_utc": { "type": "date" },
        "event_date": { "type": "date" },
        "event_hour": { "type": "integer" },
        "magnitude": { "type": "float" },
        "magnitude_bucket": { "type": "keyword" },
        "place": {
          "type": "text",
          "fields": {
            "keyword": { "type": "keyword", "ignore_above": 256 }
          }
        },
        "region_text": { "type": "keyword" },
        "latitude": { "type": "float" },
        "longitude": { "type": "float" },
        "depth_km": { "type": "float" },
        "significance": { "type": "integer" },
        "tsunami_flag": { "type": "boolean" },
        "status": { "type": "keyword" },
        "mag_type": { "type": "keyword" },
        "network": { "type": "keyword" },
        "updated_time_utc": { "type": "date" },
        "ingest_time_utc": { "type": "date" },
        "location": { "type": "geo_point" },
        "title": { "type": "text" },
        "event_url": { "type": "keyword", "ignore_above": 1024 }
      }
    }
  }
}

